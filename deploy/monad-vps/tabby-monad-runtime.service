[Unit]
Upholds=tabby-monad-frontend.service
Description=Tabby Monad hosted agents and independent Arena
After=network-online.target docker.service tabby-monad-gateway.service
Wants=network-online.target
Requires=docker.service tabby-monad-gateway.service
StartLimitIntervalSec=600
StartLimitBurst=3

[Service]
Type=simple
User=tabby-monad
Group=tabby-monad
SupplementaryGroups=docker
WorkingDirectory=/Users/jungle/Desktop/dev/agentfuel
EnvironmentFile=/etc/tabby-monad/runtime.env
ExecStart=/opt/tabby-monad/node/bin/node --import tsx scripts/monad-hosted-runtime.ts start /Users/jungle/Desktop/dev/agentfuel/demo-output/monad-hosted-20261012/runtime /Users/jungle/Desktop/dev/agentfuel/demo-output/monad-hosted-20261012/bootstrap.json --recover
ExecStartPost=/bin/bash /Users/jungle/Desktop/dev/agentfuel/deploy/monad-vps/wait-ready.sh runtime
UMask=0077
# Docker needs to see the host /tmp path used in submission bind mounts.
PrivateTmp=false
NoNewPrivileges=true
TimeoutStartSec=600
TimeoutStopSec=90
KillMode=mixed
Restart=on-failure
RestartSec=15
LimitNOFILE=16384

[Install]
WantedBy=multi-user.target
