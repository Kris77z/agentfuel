# chain (default) never substitutes local sample balances for missing network data.
FRONTEND_MODE=chain
# Absolute path, or relative to frontend/; see deployment.example.json.
FRONTEND_MANIFEST_PATH=
# Server-only explicit RPC transport. Requires the configured macOS HTTPS proxy when enabled.
FRONTEND_RPC_TRANSPORT=direct
# Optional server-only fixed demo private/state.json path; only verified SpendRejected fields are returned.
FRONTEND_DEMO_STATE_PATH=
# FRONTEND_RPC_TRANSPORT=system-https-proxy
# Explicit local visual demo, no RPC, no wallet broadcasts:
# FRONTEND_MODE=fixture

# Server-only loopback workflow service; browser always calls /api/tasks/runs.
# Leave unset to expose a disabled state without model calls.
# TASK_RUNNER_URL=http://127.0.0.1:8790
