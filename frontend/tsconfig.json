{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    ".next-arena/types/**/*.ts",
    ".next-arena/dev/types/**/*.ts",
    ".next-arena-prod/types/**/*.ts",
    ".next-arena-prod/dev/types/**/*.ts",
    ".next-gamefi/types/**/*.ts",
    ".next-gamefi/dev/types/**/*.ts",
    ".next-gamefi-prod/types/**/*.ts",
    ".next-gamefi-prod/dev/types/**/*.ts",
    ".next-gamefi-work/types/**/*.ts",
    ".next-gamefi-work/dev/types/**/*.ts",
    ".next-practice-restart-3695e63d/types/**/*.ts",
    ".next-practice-restart-3695e63d/dev/types/**/*.ts",
    ".next-gamefi-final/types/**/*.ts",
    ".next-gamefi-final/dev/types/**/*.ts",
    ".next-hosted-test/types/**/*.ts",
    ".next-hosted-test/dev/types/**/*.ts",
    ".next-terminal-test/types/**/*.ts",
    ".next-terminal-test/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
